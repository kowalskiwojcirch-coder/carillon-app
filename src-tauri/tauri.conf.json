{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carillon",
  "version": "0.1.0",
  "identifier": "pl.carillon.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Carillon",
        "width": 1050,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Wirtualny instrument Carillon",
    "longDescription": "Prototyp wirtualnego instrumentu Carillon.",
    "category": "Music",
    "icon": []
  }
}
